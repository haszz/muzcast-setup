{
  "name": "muzcast-setup",
  "productName": "Muzcast à la maison",
  "version": "0.1.5",
  "description": "Installer Muzcast TV et Muzcast sur votre téléviseur Android.",
  "license": "MIT",
  "author": "Muzcast — based on CleanMyTV by Vivek",
  "homepage": "https://tv.muzcast.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/haszz/muzcast-setup.git"
  },
  "bugs": {
    "url": "https://github.com/haszz/muzcast-setup/issues"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "sync": "node scripts/sync-upstream.mjs",
    "home": "tsx scripts/build-home.ts",
    "dist:mac": "npm run build:relay && electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "build:relay": "node scripts/build-relay.mjs",
    "build:app-metadata": "node scripts/build-app-metadata.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "posthog-node": "^5.21.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
